# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION (Optional for local development)
# You can provide a single connection string:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_db"
# Or individual connection parameters:
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="whatsapp_db"

# WhatsApp/automation credentials are NOT stored in .env.
# Each approved business enters its own credentials after login; secrets are encrypted in PostgreSQL.

# APPLICATION LOGIN
# POC fixed Super Admin is created by src/db/users.ts.
# Mobile: +919999999999   Password: Admin@12345
# Business users never use environment credentials; they register with mobile + password.
# Use a long random secret in production. Changing it signs out existing mobile sessions.
AUTH_TOKEN_SECRET="change-this-to-a-long-random-production-secret"

# Server-side encryption key used only to encrypt/decrypt per-business stored credentials.
# This is not a WhatsApp credential. Use a long random secret in production.
CREDENTIAL_ENCRYPTION_KEY="change-this-to-a-long-random-encryption-secret"

# Meta Embedded Signup (platform-level onboarding only; business automation tokens are stored encrypted per business)
META_PLATFORM_APP_ID=
META_PLATFORM_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0
