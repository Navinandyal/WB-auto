# ============================================================
# GreetSync backend configuration
# Copy this file to .env for local testing only.
# On Render, configure these as service Environment variables instead.
# NEVER commit the real .env file.
# ============================================================


# Supabase Session pooler PostgreSQL. Rotate any URL/password that was shared publicly.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_SSL=true

# Required production security secrets. The one-click setup script generates these.
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
CREDENTIAL_ENCRYPTION_KEY="replace-with-an-independent-long-random-secret"

# Permanent public HTTPS backend URL from your Render web service.
# Example: https://YOUR-SERVICE.onrender.com
PUBLIC_BASE_URL=""
META_PUBLIC_BASE_URL=""
APP_URL=""

# Provider Meta settings can be configured from Super Admin > Configuration.
# They are stored encrypted in PostgreSQL. Environment variables remain optional fallback values.
META_PLATFORM_APP_ID=
META_PLATFORM_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=

# Optional AI functionality if used.
# AI Template Generator: backend only; never put this key in the mobile app.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted when GEMINI_API_KEY is empty.
# Configure the key on Render's backend service; rebuilding the APK cannot set it.

# Local DB fallback below is only for NODE_ENV != production and only when DATABASE_URL is absent.
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="whatsapp_db"

# Optional FCM background push. Supply JSON through a server secret; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Override the Gemini model used for AI template generation if needed.
GEMINI_TEMPLATE_MODEL=auto
# auto selects a supported text Flash model from Google's model list for this key.
# ffprobe must be installed for WhatsApp video validation (included in Docker).
FFPROBE_PATH=ffprobe

# pdfinfo (Poppler) validates PDF pages; included in Docker.
PDFINFO_PATH=pdfinfo

DATABASE_PROVIDER=supabase
# Filled by one-command setup; includes user identity for a shared Supabase pooler.
DATABASE_TARGET_USER=
