# Private one-time deployment configuration. Never commit this file after copying.
RENDER_API_KEY=
# Supabase Dashboard > Connect > Session pooler (port 5432). URL-encode password.
SUPABASE_DATABASE_URL=
# Existing complete Railway pg_dump: custom .dump or UTF-8 COPY-format .sql.
DATABASE_RESTORE_FILE=backups/greetsync.dump
# Set true ONLY after stopping the old backend/workers and taking the final backup.
MIGRATION_SOURCE_STOPPED=false
# Keep the ORIGINAL values. Replacements would break encrypted WhatsApp tokens.
# Values already in your existing private .env are reused when these are omitted.
# AUTH_TOKEN_SECRET=
# CREDENTIAL_ENCRYPTION_KEY=
# Optional when PostgreSQL client tools aren't on PATH; versions 18 etc auto-detected.
POSTGRES_BIN=
